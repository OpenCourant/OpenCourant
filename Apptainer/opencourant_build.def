# Builds OpenCourant from source inside the container, for sites that
# require source builds (air-gapped mirrors, local patches, policy).
# Most users want the prebuilt options instead: download the
# OpenCourant_<arch>.sif release asset, or build Apptainer/opencourant.def,
# or pull docker://ghcr.io/opencourant/opencourant directly.
#
# Arguments (apptainer build --build-arg NAME=VALUE):
#   ARCH        solver architecture: linux64_gf (default) or linuxa64_gf
#   ARCH_DIR    runtime library directory: linux64 (default) or linuxa64
#   SOURCE_REF  git ref to build; the default resolves the latest stable
#               release tag at build time (use SOURCE_REF=main for HEAD)
#
# arm64 example:
#   apptainer build opencourant.sif opencourant_build.def \
#       --build-arg ARCH=linuxa64_gf --build-arg ARCH_DIR=linuxa64

Bootstrap: docker
From: rockylinux:9

%arguments
ARCH=linux64_gf
ARCH_DIR=linux64
SOURCE_REF=latest-release

%post
dnf group install -y "Development Tools"
dnf install -y \
gcc gcc-gfortran gcc-c++ make cmake perl git-lfs \
wget git patch diffutils libxcrypt-compat \
which python3 openssh-clients

export NCPU=$(nproc)

cd /tmp
wget -q https://download.open-mpi.org/release/open-mpi/v4.1/openmpi-4.1.2.tar.gz
tar xzf openmpi-4.1.2.tar.gz
cd openmpi-4.1.2
./configure --prefix=/opt/openmpi
make -j$NCPU
make install
cd /tmp && rm -rf openmpi-4.1.2*

SOURCE_REF="{{ SOURCE_REF }}"
if [ "$SOURCE_REF" = "latest-release" ]
then
    SOURCE_REF=$(curl -s https://api.github.com/repos/OpenCourant/OpenCourant/releases/latest | grep '"tag_name"' | cut -d'"' -f4)
fi
echo "Building OpenCourant ref: $SOURCE_REF"

cd /opt
git lfs install
git clone --depth 1 --branch "$SOURCE_REF" https://github.com/OpenCourant/OpenCourant.git
cd /opt/OpenCourant/starter
./build_script.sh -arch={{ ARCH }} -nt=$NCPU -release
cd /opt/OpenCourant/engine
./build_script.sh -arch={{ ARCH }} -nt=$NCPU -release
./build_script.sh -arch={{ ARCH }} -mpi=ompi -nt=$NCPU -release

# Output converters live in the Tools repository
cd /opt
git clone --depth 1 https://github.com/OpenCourant/Tools.git
cd /opt/Tools/output_converters/anim_to_vtk/{{ ARCH_DIR }}
bash build.bash
cd /opt/Tools/output_converters/th_to_csv/{{ ARCH_DIR }}
bash build.bash
cp /opt/Tools/exec/* /opt/OpenCourant/exec/
rm -rf /opt/Tools

# Convenience names matching the published container image
cd /opt/OpenCourant/exec
ln -s starter_{{ ARCH }}         starter
ln -s starter_{{ ARCH }}_sp      starter_sp
ln -s engine_{{ ARCH }}          engine
ln -s engine_{{ ARCH }}_sp       engine_sp
ln -s engine_{{ ARCH }}_ompi     engine_ompi
ln -s engine_{{ ARCH }}_ompi_sp  engine_ompi_sp

echo "$SOURCE_REF" > /opt/OpenCourant/.source_ref

%environment
export OPENCOURANT_PATH=/opt/OpenCourant
export RAD_CFG_PATH=$OPENCOURANT_PATH/hm_cfg_files
export OMP_STACKSIZE=400m

export PATH=$OPENCOURANT_PATH/exec:/opt/openmpi/bin:$PATH
export LD_LIBRARY_PATH=$OPENCOURANT_PATH/extlib/hm_reader/{{ ARCH_DIR }}:$OPENCOURANT_PATH/extlib/h3d/lib/{{ ARCH_DIR }}:/opt/openmpi/lib:$LD_LIBRARY_PATH

%labels
    org.opencontainers.image.source https://github.com/OpenCourant/OpenCourant

%help
    OpenCourant built from source ({{ ARCH }}). Executables are on PATH:
    starter, engine, engine_ompi (plus _sp single-precision variants) and
    the anim_to_vtk / th_to_csv converters.
