#!/bin/bash
#
# OpenCourant copyright-header hook.
# Install by copying (or symlinking) into .git/hooks/pre-commit.
#
# Verifies that every staged file carries a valid header and the
# OpenCourant modification notice, repairing in place where possible
# (repaired files are re-staged).  The same check runs in CI
# (scripts/copyright/check_headers.py), so skipping this hook only
# defers the failure.

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

if ! python3 scripts/copyright/check_headers.py --fix $staged; then
    echo "pre-commit: copyright headers could not all be repaired" >&2
    exit 1
fi

# Re-stage anything the fixer touched
changed=$(git diff --name-only -- $staged)
[ -n "$changed" ] && git add $changed

exit 0
